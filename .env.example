# ==========================================
# Telegram Movie Sender Bot Configuration
# ==========================================

# Your Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram User ID(s) of Bot Admins (comma-separated)
# You can get your ID from @userinfobot or @MissRose_bot (/id)
ADMIN_IDS=123456789

# Storage Channel ID (Optional but highly recommended)
# When you add the bot as admin to this channel, every video/file posted here is automatically indexed!
# e.g., -1001234567890
STORAGE_CHANNEL_ID=

# Force-Subscribe (FSUB) Channel (Optional)
# If set, users must join this channel before searching or getting movies.
# e.g., @MyMovieChannel or -1001234567890
FSUB_CHANNEL_ID=

# Invite link for the FSUB channel (e.g., https://t.me/MyMovieChannel or private invite link)
FSUB_INVITE_LINK=

# Auto-Delete Movie Timer in Seconds (e.g., 600 = 10 minutes, set 0 to disable)
# Protects bot against copyright strikes by deleting movie files from user chats after the timer.
AUTO_DELETE_SECONDS=600

# OMDb API Key for IMDb Posters & Movie Info (Optional, get free key at http://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# SQLite Database File
DATABASE_PATH=movies.db

# VIP Subscription & Payment Settings
UPI_ID=yourname@upi
UPI_NAME=Movie World VIP
ADMIN_CONTACT_USERNAME=JatharPatil
PAYMENT_QR_IMAGE=
ADMIN_GROUP_ID=


